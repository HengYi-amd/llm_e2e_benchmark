# Benchmark configuration. Every value can be overridden from the environment,
# so a variant run needs no edit to this file.

# ---------------------------------------------------------------- what to test

# Dense models only: MoE routing changes which GEMMs exist, so the arms would
# no longer measure the same thing.
: "${E2E_MODELS:=Qwen/Qwen3-8B Qwen/Qwen3-32B}"
: "${E2E_DTYPES:=bfloat16}"

# Two arms differing in exactly one thing: the Inductor GEMM backend list.
: "${E2E_ARMS:=baseline treatment}"
: "${E2E_BACKENDS_baseline:=ATEN,TRITON}"
: "${E2E_BACKENDS_treatment:=ATEN,TRITON,FLYDSL}"

# Passed as --max-concurrency; it becomes the decode GEMM's M dimension.
: "${E2E_CONCURRENCY_SWEEP:=1 2 4 8 16 32 64 128}"

# Workload profiles as "name:ISL:OSL". The list must cover both inference
# phases: a long-ISL profile so chunked prefill is exercised and TTFT is
# meaningful, and a short-ISL profile that reports decode alone.
: "${E2E_PROFILES:=chunked blog}"
: "${E2E_PROFILE_chunked:=2048:128}"
: "${E2E_PROFILE_blog:=32:128}"

: "${E2E_REPEATS:=2}"
: "${E2E_NUM_PROMPTS_MULT:=4}"   # num-prompts = concurrency * this, min E2E_NUM_PROMPTS_MIN
: "${E2E_NUM_PROMPTS_MIN:=32}"

# ------------------------------------------------------------------- engine

# TP=1: sharding N and K narrows the GEMMs under test and adds collective time
# both arms pay equally. The sweep still uses every GPU, as independent
# single-GPU shards (scripts/bench/run_sharded.sh).
: "${E2E_TP:=1}"

# Pinned because the default chunk size differs between the offline and the
# server path, which would make results depend on the harness used.
: "${E2E_MAX_NUM_BATCHED_TOKENS:=8192}"
: "${E2E_MAX_MODEL_LEN:=4096}"
: "${E2E_GPU_MEM_UTIL:=0.85}"

# KV cache capacity must be identical across arms or throughput differences
# include memory differences; vLLM would otherwise derive it from each arm's
# own profiling peak. Empty = let vLLM decide, and normalize flags the cells
# as not comparable.
: "${E2E_KV_CACHE_BYTES:=}"

# ------------------------------------------------------------------ autotune

# EXHAUSTIVE would replace the curated Triton configs with thousands of
# candidates and bypass origami, measuring a path that is not shipped.
: "${E2E_AUTOTUNE_SEARCH_SPACE:=DEFAULT}"

# Pinned because it is on by default and invisible: with origami on, "TRITON"
# means the origami model's top-K, not the curated config list.
: "${E2E_ORIGAMI:=1}"
: "${E2E_ORIGAMI_TOPK:=6}"

# Must be 1 for the treatment arm; off, FlyDSL offers a single hardcoded config
# against a tuned Triton, which is not a backend comparison.
: "${E2E_FLYDSL_AUTOTUNING:=1}"

# ------------------------------------------------------------------- metrics

# Headline is TPOT: decode and prefill GEMMs move by different factors, so a
# fused wall-clock number blends two effects.
: "${E2E_HEADLINE_METRIC:=mean_tpot_ms}"
: "${E2E_METRICS:=mean_tpot_ms mean_ttft_ms output_throughput}"

# --------------------------------------------------------------------- budget

: "${E2E_BUDGET_S:=43200}"        # stop collecting after this many seconds
: "${E2E_SERVER_TIMEOUT_S:=1800}" # server must come up within this
: "${E2E_CLIENT_TIMEOUT_S:=1800}" # one concurrency point must finish within this

# ------------------------------------------------------------------ container

# Empty = run daemon commands directly; a container name wraps every command in
# `podman exec`.
: "${E2E_CONTAINER:=}"
# The repo's path as seen from inside that container, if it differs.
: "${E2E_CONTAINER_ROOT:=$E2E_ROOT}"

# GPUs the sharded sweep may use.
: "${E2E_GPUS:=0 1 2 3 4 5 6 7}"
