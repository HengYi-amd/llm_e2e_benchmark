# Benchmark configuration. Every value can be overridden from the environment,
# so a variant run needs no edit to this file.

# ---------------------------------------------------------------- what to test

# Dense models only: MoE routing changes which GEMMs exist, so the arms would
# no longer measure the same thing.
: "${E2E_MODELS:=meta-llama/Llama-3.1-8B-Instruct Qwen/Qwen3-32B meta-llama/Llama-3.3-70B-Instruct}"
# The 70B weights leave roughly 100 GB for KV on a 288 GB card at the
# utilisation below; if the top of the concurrency sweep runs out of
# memory, lower E2E_GPU_MEM_UTIL or shorten E2E_CONCURRENCY_SWEEP.
: "${E2E_DTYPES:=bfloat16}"

# Two arms differing in exactly one thing: the Inductor GEMM backend list.
: "${E2E_ARMS:=baseline treatment}"
: "${E2E_BACKENDS_baseline:=ATEN,TRITON}"
: "${E2E_BACKENDS_treatment:=ATEN,TRITON,FLYDSL}"

# Passed as --max-concurrency; it becomes the decode GEMM's M dimension.
: "${E2E_CONCURRENCY_SWEEP:=8 16 32 64 128 256}"

# Workload profiles as "name:ISL:OSL". The list must cover both inference
# phases: a long-ISL profile so chunked prefill is exercised and TTFT is
# meaningful, and a short-ISL profile that reports decode alone.
: "${E2E_PROFILES:=showcase}"
: "${E2E_PROFILE_chunked:=2048:128}"
: "${E2E_PROFILE_blog:=32:128}"

# Two repeats is the minimum that measures anything: the repeat spread on this
# workload is ~1.2% median and 2.6% worst case, so a single pass cannot tell a
# 2% effect from drift, and its sign flips between runs. Aggregation takes the
# median per cell and reports the spread alongside it.
: "${E2E_REPEATS:=2}"
: "${E2E_NUM_PROMPTS_MULT:=4}"   # num-prompts = concurrency * this, min E2E_NUM_PROMPTS_MIN
: "${E2E_NUM_PROMPTS_MIN:=32}"

# ------------------------------------------------------------------- engine

# TP=1: sharding N and K narrows the GEMMs under test and adds collective time
# both arms pay equally. The sweep still uses every GPU, as independent
# single-GPU shards (scripts/bench/run_sharded.sh).
: "${E2E_TP:=1}"

# Pinned because the default chunk size differs between the offline and the
# server path, which would make results depend on the harness used.
: "${E2E_MAX_NUM_BATCHED_TOKENS:=2048}"
: "${E2E_MAX_MODEL_LEN:=1024}"
# 0.85 with the KV size pinned below. Higher values leave less headroom for the
# compile workspace and produced KV-allocation failures on the 70B model.
: "${E2E_GPU_MEM_UTIL:=0.85}"

# KV cache capacity must be identical across arms or throughput differences
# include memory differences; vLLM would otherwise derive it from each arm's
# own profiling peak. Empty = let vLLM decide, and normalize flags the cells
# as not comparable.
: "${E2E_KV_CACHE_BYTES:=}"

# ------------------------------------------------------------------ autotune

# EXHAUSTIVE would replace the curated Triton configs with thousands of
# candidates and bypass origami, measuring a path that is not shipped.
: "${E2E_AUTOTUNE_SEARCH_SPACE:=EXHAUSTIVE}"

# Pinned because it is on by default and invisible: with origami on, "TRITON"
# means the origami model's top-K, not the curated config list.
: "${E2E_ORIGAMI:=1}"
: "${E2E_ORIGAMI_TOPK:=6}"

# Must be 1 for the treatment arm; off, FlyDSL offers a single hardcoded config
# against a tuned Triton, which is not a backend comparison.
: "${E2E_FLYDSL_AUTOTUNING:=1}"

# ------------------------------------------------------------------- metrics

# Headline is TPOT: decode and prefill GEMMs move by different factors, so a
# fused wall-clock number blends two effects.
: "${E2E_HEADLINE_METRIC:=mean_tpot_ms}"
: "${E2E_METRICS:=mean_tpot_ms mean_ttft_ms mean_e2el_ms output_throughput}"

# --------------------------------------------------------------------- budget

: "${E2E_BUDGET_S:=86400}"        # stop collecting after this many seconds
# Under EXHAUSTIVE the server autotunes every compile_size during startup:
# 8 rounds at the measured ~1600s each is about 3.6h before it serves its
# first request. A one-hour budget kills every server mid-compile.
: "${E2E_SERVER_TIMEOUT_S:=43200}" # wall clock for a server to become ready
# A hung startup stops writing to its log; a slow one does not. This catches
# the first without cutting the second short.
# Longest silent phase under EXHAUSTIVE: precompiling 4080 Triton candidates
# takes about 816s at the measured 0.20 s/candidate and logs nothing while it
# runs. A 900s stall limit therefore kills healthy servers mid-compile.
: "${E2E_SERVER_STALL_S:=5400}"
: "${E2E_CLIENT_TIMEOUT_S:=1800}" # one concurrency point must finish within this

# ------------------------------------------------------------------ container

# Empty = run daemon commands directly; a container name wraps every command in
# `podman exec`.
: "${E2E_CONTAINER:=}"
# The repo's path as seen from inside that container, if it differs.
: "${E2E_CONTAINER_ROOT:=$E2E_ROOT}"

# GPUs the sharded sweep may use.
: "${E2E_GPUS:=}"

# Precompilation budget. A choice that misses it is dropped, which makes the
# surviving candidate set depend on machine load; raise it far enough that
# nothing is dropped under EXHAUSTIVE.
E2E_PRECOMPILE_TIMEOUT_S=3600
# Showcase profile: small prefill, long decode, so the decode GEMM dominates.
: "${E2E_PROFILE_showcase:=256:512}"

# Inductor caps its compile-worker pool at 32 unless told otherwise; this node
# has far more cores and EXHAUSTIVE precompilation is the dominant cost.
: "${E2E_COMPILE_THREADS:=128}"
# Concurrency 256 needs at least that many sequence slots.
: "${E2E_MAX_NUM_SEQS:=256}"

# The routing gate only asserts that FlyDSL enters the candidate set, which is
# independent of the search space; running it EXHAUSTIVE costs an hour and
# proves nothing extra. The real verification is 06_route_proof on the sweep's
# own artifacts.
: "${SMOKE_AUTOTUNE_SEARCH_SPACE:=DEFAULT}"
# The sweep is the long pole under EXHAUSTIVE; bound it generously and let the
# supervisor relaunches anything still missing at the end of a sweep.
: "${E2E_SWEEP_TIMEOUT_S:=172800}"
# Keep Triton on its default config list even when the global search space is
# exhaustive; its exhaustive list is what makes the sweep take hours.
: "${E2E_TRITON_DEFAULT_SPACE:=1}"

# Directory under E2E_RESULT holding the cross-model comparison figures that
# scripts/plot/combined.py writes. One chart per metric, both models on it.
: "${E2E_COMBINED_DIR:=bf16_result_png}"

# Suffix on the published per-model directory name: result/<Model>_<dtype><suffix>.
# Pinned so a fresh clone produces the directory names the documentation refers
# to; an empty suffix silently publishes to a different path.
: "${E2E_RESULT_SUFFIX:=_exhaustive}"
